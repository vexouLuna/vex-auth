# Copy to .env and fill in. Placeholder values only: never commit real ones.
# Secrets are not here: they are files in secrets/ (copy secrets.example/). For a run without compose, any
# of them can be set here instead, as AUTH_DATABASE_URL, AUTH_TWITCH_CLIENT_SECRET, AUTH_TOKEN_KEY or
# AUTH_CLIENTS; a variable wins over its file.

# Where browsers reach this service. The Twitch application's OAuth redirect URL must be
# <AUTH_PUBLIC_URL>/callback, exactly.
AUTH_PUBLIC_URL=https://auth.example.net

# The Twitch application (dev.twitch.tv/console). Its secret is secrets/auth_twitch_client_secret.
AUTH_TWITCH_CLIENT_ID=your-twitch-client-id

# The sites, comma separated: the only pages that may read /v1/* and the only places /login returns to.
AUTH_SITE_ORIGINS=https://example.net,https://vods.example.net

# Where an error page links back to when it does not know which site started the sign-in.
# AUTH_HOME_URL=https://example.net

# Backends that sign people in through this service are secrets/auth_clients: JSON, a list of
# {"id","secret","redirect_uris","scopes"}, where scopes may only name user:read:moderated_channels.

# AUTH_SESSION_DAYS=30
# Only for local development over plain http:
# AUTH_COOKIE_SECURE=false
# AUTH_PORT=8090
# Reverse proxies whose X-Forwarded-For is believed (for rate limits and the audit log).
# AUTH_FORWARDED_ALLOW_IPS=127.0.0.1
